---
import SewingMachinePattern from './SewingMachinePattern.astro';
import { waLink } from '../data/site';
---

<section class="hero">
	<div class="wrap grid">
		<div class="intro" data-reveal>
			<p class="label hand">No. 01 · Taller de costura</p>
			<p class="lead hand">
				Havana es un taller de costura para negocios, emprendedores y marcas. Confeccionamos a medida, producimos
				por lote y arreglamos lo que ya tienes.
			</p>
		</div>

		<div class="visual">
			<SewingMachinePattern />
		</div>

		<h1 class="display title">Luce,<br /><em>tu estilo.</em></h1>

		<div class="cta">
			<a class="btn" href={waLink()} target="_blank" rel="noopener">Cotizar por WhatsApp</a>
			<a class="link-dashed" href="#proceso">Cómo trabajamos</a>
		</div>
	</div>
</section>

<style>
	.hero {
		padding: clamp(3rem, 7vw, 5rem) 0 clamp(2rem, 5vw, 3rem);
		overflow-x: clip;
	}
	.grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		grid-template-areas:
			'intro visual'
			'title visual'
			'cta visual';
		column-gap: 3rem;
	}
	.intro {
		grid-area: intro;
		max-width: 30rem;
		display: grid;
		gap: 1.25rem;
	}
	.visual {
		grid-area: visual;
		width: 100%;
		/* más grande que su columna: se sale por la derecha y queda cortada por el borde */
		width: 130%;
		max-width: 56rem;
		justify-self: start;
		align-self: start;
		translate: 4% -6%;
	}
	.title {
		grid-area: title;
		align-self: end;
		font-size: clamp(4.5rem, 8.2vw, 8.5rem);
		margin-top: 3rem;
		white-space: nowrap;
	}
	.title em {
		display: inline-block;
		position: relative;
		margin-left: 0.4em;
	}
	/* pespunte que subraya "tu estilo" */
	.title em::after {
		content: '';
		position: absolute;
		left: 0.05em;
		right: 0.1em;
		bottom: 0.02em;
		height: 4px;
		background: repeating-linear-gradient(90deg, #d97fd0 0 16px, transparent 16px 26px);
		transform: scaleX(0);
		transform-origin: left;
		animation: sew-line 1.8s 0.6s cubic-bezier(0.45, 0, 0.25, 1) forwards;
	}
	@keyframes sew-line {
		to {
			transform: scaleX(1);
		}
	}
	.cta {
		grid-area: cta;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.5rem 2rem;
		margin-top: 3rem;
	}
	@media (prefers-reduced-motion: reduce) {
		.title em::after {
			animation: none;
			transform: none;
		}
	}
	@media (max-width: 860px) {
		.grid {
			grid-template-columns: 1fr;
			grid-template-areas: 'intro' 'title' 'visual' 'cta';
		}
		.visual {
			width: 150%;
			margin-top: 1.5rem;
			translate: 12% 0;
		}
		.title em {
			margin-left: 0.3em;
		}
	}
</style>
