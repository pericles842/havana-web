---
import SewingMachinePattern from './SewingMachinePattern.astro';
import { waLink } from '../data/site';
---

<section class="hero">
	<div class="wrap grid">
		<div class="intro" data-reveal>
			<p class="label hand">No. 01 · Taller de costura</p>
			<p class="lead hand">
				Havana es un taller de costura para negocios, emprendedores y marcas. Confeccionamos a medida, producimos
				por lote y arreglamos lo que ya tienes.
			</p>
		</div>

		<div class="visual">
			<SewingMachinePattern />
		</div>

		<h1 class="display title">
			<!-- versión final a color: aparece cuando termina el dibujo de la máquina -->
			<span class="final">Luce,<br /><em>tu estilo.</em></span>
			<!-- boceto a lápiz encima: se escribe primero y luego se desvanece -->
			<span class="sketch" aria-hidden="true"><span class="l1">Luce,</span><br /><em>tu estilo.</em></span>
			<svg class="pencil-defs" width="0" height="0" aria-hidden="true">
				<filter id="pencil" x="-5%" y="-10%" width="110%" height="120%">
					<feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="5"></feTurbulence>
					<feDisplacementMap in="SourceGraphic" scale="4"></feDisplacementMap>
				</filter>
			</svg>
		</h1>

		<div class="cta">
			<a class="btn" href={waLink()} target="_blank" rel="noopener">Cotizar por WhatsApp</a>
			<a class="link-dashed" href="#proceso">Cómo trabajamos</a>
		</div>
	</div>
</section>

<style>
	.hero {
		padding: clamp(3rem, 7vw, 5rem) 0 clamp(2rem, 5vw, 3rem);
		overflow-x: clip;
	}
	.grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		grid-template-areas:
			'intro visual'
			'title visual'
			'cta visual';
		column-gap: 3rem;
	}
	.intro {
		grid-area: intro;
		max-width: 30rem;
		display: grid;
		gap: 1.25rem;
	}
	.visual {
		grid-area: visual;
		width: 100%;
		/* más grande que su columna: se sale por la derecha y queda cortada por el borde */
		width: 130%;
		max-width: 56rem;
		justify-self: start;
		align-self: start;
		translate: 4% -6%;
	}
	.title {
		grid-area: title;
		align-self: end;
		position: relative;
		font-size: clamp(4.5rem, 8.2vw, 8.5rem);
		line-height: 0.86;
		margin-top: 3rem;
		white-space: nowrap;
	}
	.title em {
		display: inline-block;
		position: relative;
		margin-left: 0.4em;
	}
	.pencil-defs {
		position: absolute;
	}

	/* 1. Boceto a lápiz: solo contorno tembloroso, se escribe de izquierda a derecha */
	.sketch {
		position: absolute;
		inset: 0;
		color: transparent;
		-webkit-text-stroke: 1.1px rgba(43, 45, 82, 0.75);
		filter: url(#pencil);
		pointer-events: none;
		animation: sketch-out 0.9s 4.3s ease forwards;
	}
	.sketch em {
		background: none;
		-webkit-text-stroke-color: rgba(126, 103, 229, 0.85);
	}
	.sketch .l1,
	.sketch em {
		display: inline-block;
		clip-path: inset(-0.2em 100% -0.3em -0.1em);
		animation: write 1.6s cubic-bezier(0.45, 0, 0.25, 1) forwards;
	}
	.sketch .l1 {
		animation-delay: 0.3s;
	}
	.sketch em {
		animation-delay: 1.7s;
		animation-duration: 1.9s;
	}
	@keyframes write {
		to {
			clip-path: inset(-0.2em -0.2em -0.3em -0.1em);
		}
	}
	@keyframes sketch-out {
		to {
			opacity: 0;
		}
	}

	/* 2. Versión final a color: entra al terminar el dibujo */
	.final {
		display: block;
		opacity: 0;
		animation: ink-in 1s 4.1s ease forwards;
	}
	@keyframes ink-in {
		to {
			opacity: 1;
		}
	}
	.cta {
		grid-area: cta;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.5rem 2rem;
		margin-top: 3rem;
	}
	@media (prefers-reduced-motion: reduce) {
		.final {
			animation: none;
			opacity: 1;
		}
		.sketch {
			display: none;
		}
	}
	@media (max-width: 860px) {
		.grid {
			grid-template-columns: 1fr;
			grid-template-areas: 'intro' 'title' 'visual' 'cta';
		}
		.visual {
			width: 150%;
			margin-top: 1.5rem;
			translate: 12% 0;
		}
		.title em {
			margin-left: 0.3em;
		}
	}
</style>
