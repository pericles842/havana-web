---
import { Image } from 'astro:assets';
import { photos } from '../data/site';
---

<section id="nosotros" class="section">
	<div class="wrap grid">
		<figure class="photo" data-reveal>
			<Image src={photos.about.src} alt={photos.about.alt} width={900} />
			<span class="tape tape--a" aria-hidden="true"></span>
			<span class="tape tape--b" aria-hidden="true"></span>
		</figure>
		<div class="text" data-reveal style="--d:0.15s">
			<p class="label">Quiénes somos</p>
			<h2 class="display h2">Un taller pequeño que cose <em>como una marca grande.</em></h2>
			<p class="lead muted">
				En Havana cortamos, cosemos y revisamos cada pieza en el mismo taller. Trabajamos de cerca con cada
				cliente para que el resultado se parezca a lo que imaginó, y que la última prenda del lote salga igual que
				la primera.
			</p>
		</div>
	</div>
</section>

<style>
	.grid {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
		gap: 4rem;
		align-items: center;
	}
	.photo {
		position: relative;
		margin: 0;
		aspect-ratio: 4 / 5;
		padding: 0.75rem 0.75rem 3rem;
		background: #fff;
		transform: rotate(-2deg);
		box-shadow: 0 30px 40px -28px rgba(43, 45, 82, 0.5);
	}
	.photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	/* cinta de papel sujetando la foto */
	.tape {
		position: absolute;
		width: 7rem;
		height: 1.9rem;
		background: rgba(240, 174, 187, 0.55);
		border-left: 1px dashed rgba(43, 45, 82, 0.2);
		border-right: 1px dashed rgba(43, 45, 82, 0.2);
	}
	.tape--a {
		top: -0.8rem;
		left: -1.5rem;
		transform: rotate(-28deg);
	}
	.tape--b {
		top: -0.6rem;
		right: -1.5rem;
		transform: rotate(24deg);
		background: rgba(126, 103, 229, 0.35);
	}
	.text {
		display: grid;
		gap: 1.75rem;
	}
	@media (max-width: 860px) {
		.grid {
			grid-template-columns: 1fr;
		}
		.photo {
			max-width: 24rem;
		}
	}
</style>
