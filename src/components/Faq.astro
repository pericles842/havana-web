---
import { faqs } from '../data/site';
---

<section class="section band">
	<div class="wrap grid">
		<div>
			<h2 class="display title">Lo que nos preguntan antes de empezar.</h2>
			<p class="muted small">¿Algo más? Pregúntanos por WhatsApp.</p>
		</div>
		<div class="list">
			{
				faqs.map((f) => (
					<details>
						<summary class="display">{f.q}</summary>
						<p class="muted">{f.a}</p>
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	.grid {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(0, 4fr);
		gap: 3rem 5rem;
	}
	.title {
		font-size: clamp(2.4rem, 4vw, 3.5rem);
		line-height: 1.08;
	}
	.small {
		margin-top: 1.75rem;
		font-size: 0.95rem;
	}
	.list {
		border-top: 1px dashed var(--line);
	}
	details {
		border-bottom: 1px dashed var(--line);
	}
	summary {
		list-style: none;
		cursor: pointer;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1.5rem;
		padding: 1.6rem 0;
		font-size: clamp(1.35rem, 2.2vw, 1.9rem);
		line-height: 1.25;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	summary::after {
		content: '+';
		font-family: var(--font-sans);
		font-size: 1.8rem;
		color: var(--color-secondary);
		transition: transform 0.2s;
	}
	details[open] summary::after {
		transform: rotate(45deg);
	}
	summary:hover {
		color: var(--color-secondary);
	}
	details p {
		padding: 0 3rem 1.75rem 0;
		max-width: 44rem;
	}
	@media (max-width: 860px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
