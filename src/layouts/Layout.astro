---
import '../styles/theme.css';

interface Props {
	title: string;
	description?: string;
}
const { title, description = 'Havana, taller de costura: confección a medida, producción por lote y arreglos.' } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/png" href="/favicon.png" sizes="512x512" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#fbf4f8" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;500&family=Courier+Prime:wght@400;700&family=Figtree:wght@400;500;600&family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&display=swap"
		/>
		<title>{title}</title>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<script>
	import Lenis from 'lenis';

	const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

	// Scroll suave con inercia. Con "reducir movimiento" se deja el scroll nativo.
	if (!reduce) {
		const lenis = new Lenis({
			duration: 0.7,
			wheelMultiplier: 1.35,
			easing: (t) => 1 - Math.pow(1 - t, 3.5),
			anchors: { duration: 1.1 }, // enlaces #sección: se deslizan; el hueco del menú fijo sale de scroll-padding-top
		});
		const raf = (time: number) => {
			lenis.raf(time);
			requestAnimationFrame(raf);
		};
		requestAnimationFrame(raf);
	}

	// Apariciones al hacer scroll ([data-reveal]) y costuras que se cosen solas ([data-stitch])

	function sew(svg: Element) {
		if (reduce) {
			svg.querySelectorAll('.mask-path').forEach((p) => p.setAttribute('stroke-dashoffset', '0'));
			return;
		}
		svg.querySelectorAll<SVGGElement>('.needle').forEach((n) => (n.style.opacity = '1'));
		svg.querySelectorAll<SVGAnimationElement>('animate, animateMotion').forEach((a) => a.beginElement());
	}

	const io = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				entry.target.classList.add('is-visible');
				if (entry.target.matches('[data-stitch]')) sew(entry.target);
				io.unobserve(entry.target);
			}
		},
		{ threshold: 0.2, rootMargin: '0px 0px -5% 0px' },
	);

	document.querySelectorAll('[data-reveal], [data-stitch]').forEach((el) => io.observe(el));
</script>
